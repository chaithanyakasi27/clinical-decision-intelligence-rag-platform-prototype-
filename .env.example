# ============================================================
# Clinical Decision Intelligence Platform
# .env.example — copy to .env and fill in your values
# NEVER commit .env to GitHub
# ============================================================

# ── Project ──────────────────────────────────────────────────
PROJECT_NAME=clinical-decision-intelligence
ENVIRONMENT=local                        # local | staging | production
LOG_LEVEL=INFO
DEBUG=true

# ── OpenAI ───────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxx
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.0                   # 0.0 for clinical accuracy

# ── Anthropic (Claude via Bedrock or direct) ─────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# ── AWS ──────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_DEFAULT_REGION=us-east-1
AWS_S3_BUCKET_RAW=cdip-raw-clinical-docs-dev
AWS_S3_BUCKET_PROCESSED=cdip-processed-docs-dev
AWS_DYNAMODB_TABLE=cdip-metadata-dev
AWS_ECR_REPO=cdip-api

# ── Vector store ─────────────────────────────────────────────
VECTOR_STORE_TYPE=faiss                  # faiss (local) | pinecone (cloud)
FAISS_INDEX_PATH=./data/faiss_index
PINECONE_API_KEY=pcsk_xxxxxxxxxxxxxxxxxxxx
PINECONE_ENVIRONMENT=us-east-1-aws
PINECONE_INDEX_NAME=cdip-clinical-embeddings

# ── Chunking config ───────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=50
EMBEDDING_BATCH_SIZE=32

# ── Retrieval config ──────────────────────────────────────────
RETRIEVER_TOP_K=10
RERANKER_TOP_K=5
BM25_WEIGHT=0.3
DENSE_WEIGHT=0.7

# ── FastAPI ───────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=2
API_SECRET_KEY=your-secret-key-min-32-chars-change-this
API_ALGORITHM=HS256
API_ACCESS_TOKEN_EXPIRE_MINUTES=60
RATE_LIMIT_PER_MINUTE=60

# ── MLflow ────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=cdip-clinical-rag

# ── LocalStack (mock AWS for local dev) ──────────────────────
LOCALSTACK_ENDPOINT=http://localhost:4566
USE_LOCALSTACK=true                      # set false when using real AWS

# ── Synthea ───────────────────────────────────────────────────
SYNTHEA_OUTPUT_DIR=./data/synthea_output
SYNTHEA_PATIENT_COUNT=200

# ── Reference data paths ─────────────────────────────────────
ICD10_CODES_PATH=./data/reference/icd10cm_codes_2024.txt
HCC_MAPPINGS_PATH=./data/reference/2024_cms_hcc_mappings.csv
HCC_COEFFICIENTS_PATH=./data/reference/hcc_coefficients.csv
